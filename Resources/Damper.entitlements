<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Lets the app reach Sparkle's installer. The names are CFBundleIdentifier plus -spks and -spki,
         so rename them with the bundle ID. No network entitlement on purpose: Sparkle's Downloader
         XPC service fetches the feed and updates. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>io.github.tadassuksteris.damper-spks</string>
        <string>io.github.tadassuksteris.damper-spki</string>
    </array>
</dict></plist>
